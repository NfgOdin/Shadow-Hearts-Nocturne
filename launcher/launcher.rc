#include <winver.h>

1 ICON "../assets/icons/nocturne_launcher.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Shadow Hearts: Nocturne - Native PC Port Launcher"
            VALUE "ProductName", "Shadow Hearts: Nocturne"
            VALUE "OriginalFilename", "Shadow Hearts Nocturne.exe"
            VALUE "FileVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
